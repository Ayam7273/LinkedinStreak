
# Supabase -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER ONLY. Never put this in a client file.
SUPABASE_SERVICE_ROLE_KEY=

# Generate in PowerShell:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
# SERVER ONLY.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Any long random string. PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})
CRON_SECRET=

# Supabase -> Authentication -> Users -> your user -> UID
OWNER_USER_ID=
